# Copy the values you need into your environment before `streamlit run App.py`.
APP_NAME=Monitorizasaun Prezensa Estudante
# First admin account (only used when the database has no admin yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_DAYS=7
# Leave empty to use this computer's Wi-Fi address automatically.
# PUBLIC_BASE_URL=https://attendance.example.com
# 1 = one device may check in only one NIM per class, 0 = off
DEVICE_CHECK=1
UTC_OFFSET_HOURS=9
# Streaming pipeline - started automatically with `streamlit run App.py`
AUTO_START_PIPELINE=1
KAFKA_ENABLED=1
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=attendance-events
# SPARK_OUTPUT_DIR=data/spark
SPARK_STALE_SECONDS=30
DASHBOARD_REFRESH_SECONDS=5
# STUDENT_CSV=data/raw/student.csv
# DATABASE_PATH=database/attendance.db
